{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.grok/bin/grok-traces\" hook grok",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.grok/bin/grok-traces\" hook grok",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.grok/bin/grok-traces\" hook grok",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.grok/bin/grok-traces\" hook grok",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "\"$HOME/.grok/bin/grok-traces\" hook grok",
            "type": "command"
          }
        ]
      }
    ]
  }
}
