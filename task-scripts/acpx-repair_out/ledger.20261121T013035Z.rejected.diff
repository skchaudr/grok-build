+        let mut extras = HashMap::new();
+        extras.insert(
+            "r-old".to_string(),
+            RowExtra {
+                rail: vec![NodeState::Waiting],
+                agents: String::new(),
+                stalled: false,
+                question: Some("Proceed with old?".to_string()),
+                answers: None,
+            },
+        );
+        extras.insert(
+            "r-new".to_string(),
+            RowExtra {
+                rail: vec![NodeState::Waiting],
+                agents: String::new(),
+                stalled: false,
+                question: Some("Proceed with new?".to_string()),
+                answers: None,
+            },
+        );
+        extras.insert(
+            "r-next".to_string(),
+            RowExtra {
+                rail: vec![NodeState::Done(Outcome::Ok)],
+                agents: String::new(),
+                stalled: false,
+                question: None,
+                answers: Some(GateAnswer {
+                    run_id: "r-old".to_string(),
+                    choice: "Approve".to_string(),
+                }),
+            },
+        );
+        state.set_extras(extras);
