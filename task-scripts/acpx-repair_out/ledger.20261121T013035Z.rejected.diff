+    fn flow_continuation_rows(
+        &self,
+        run: &RunSummary,
+        w: usize,
+        now_ms: i64,
+    ) -> Vec<FlowListRow> {
+        let is_selected = self.flow_selected_run_id.as_deref() == Some(run.run_id.as_str());
+        if !is_selected || run.status != RunStatus::Waiting || self.is_answered(run) || w == 0 {
+            return Vec::new();
+        }
+        let extra = self.extras.get(&run.run_id);
+        let stalled = extra.map(|e| e.stalled).unwrap_or(false);
+        let dummy_theme = Theme::default();
+        let (raw_state_text, _) = self.flow_state_text(run, extra, stalled, &dummy_theme);
+        if raw_state_text.is_empty() {
+            return Vec::new();
+        }
+
+        let (state_col, state_budget) = self.flow_state_columns(run, w, now_ms);
+        if state_budget == 0 {
+            let indent = state_col.min(w);
+            let wrap_w = w.saturating_sub(indent);
+            if wrap_w == 0 {
+                return Vec::new();
+            }
+            return wrap_text(&raw_state_text, wrap_w)
+                .into_iter()
+                .map(|text| FlowListRow::Continuation { indent, text })
+                .collect();
+        }
+
+        let mut wrapped = wrap_text(&raw_state_text, state_budget);
+        if wrapped.len() <= 1 {
+            return Vec::new();
+        }
+        wrapped.remove(0);
+        wrapped
+            .into_iter()
+            .map(|text| FlowListRow::Continuation {
+                indent: state_col,
+                text,
+            })
+            .collect()
+    }
