+    fn set_extras_before_set_runs_matches_reverse_order() {
+        let runs = vec![
+            make_run("r-answered", "Answered Gate", RunStatus::Waiting, 3_000),
+            make_run("r-open", "Open Gate", RunStatus::Waiting, 2_000),
+            make_run("r-next", "Next Flow", RunStatus::Completed, 4_000),
+        ];
+        let mut extras = HashMap::new();
+        extras.insert(
+            "r-answered".to_string(),
+            RowExtra {
+                rail: vec![NodeState::Waiting],
+                agents: String::new(),
+                stalled: false,
+                question: Some("First question?".to_string()),
+                answers: None,
+            },
+        );
+        extras.insert(
+            "r-open".to_string(),
+            RowExtra {
+                rail: vec![NodeState::Waiting],
+                agents: String::new(),
+                stalled: false,
+                question: Some("Second question?".to_string()),
+                answers: None,
+            },
+        );
+        extras.insert(
+            "r-next".to_string(),
+            RowExtra {
+                rail: vec![NodeState::Done(Outcome::Ok)],
+                agents: String::new(),
+                stalled: false,
+                question: None,
+                answers: Some(GateAnswer {
+                    run_id: "r-answered".to_string(),
+                    choice: "Continue".to_string(),
+                }),
+            },
+        );
+
+        let mut modal_order = LedgerState::new();
+        modal_order.set_extras(extras.clone());
+        modal_order.set_runs(runs.clone());
+
+        let mut reverse_order = LedgerState::new();
+        reverse_order.set_runs(runs);
+        reverse_order.set_extras(extras);
+
+        assert_eq!(
+            modal_order.selected_run().map(|r| &r.run_id),
+            reverse_order.selected_run().map(|r| &r.run_id)
+        );
+        assert_eq!(
+            modal_order.answered_choice("r-answered"),
+            reverse_order.answered_choice("r-answered")
+        );
+
+        let theme = Theme::default();
+        let mut buf_a = Buffer::empty(Rect::new(0, 0, 100, 12));
+        let area_a = buf_a.area;
+        modal_order.render(&mut buf_a, area_a, &theme, 10_000);
+
+        let mut buf_b = Buffer::empty(Rect::new(0, 0, 100, 12));
+        let area_b = buf_b.area;
+        reverse_order.render(&mut buf_b, area_b, &theme, 10_000);
+
+        assert_eq!(all_text(&buf_a), all_text(&buf_b));
+    }
