+                agents: String::new(),
+                stalled: false,
+                question: Some(question.to_string()),
+                answers: None,
+            },
+        );
+        extras.insert(
+            "r-second".to_string(),
+            RowExtra {
+                rail: vec![NodeState::Waiting],
+                agents: String::new(),
+                stalled: false,
+                question: Some("Short?".to_string()),
+                answers: None,
+            },
+        );
+        state.set_extras(extras);
+
+        assert_eq!(
+            state.selected_run().map(|r| r.run_id.as_str()),
