+    #[test]
+    fn answered_gate_reduces_needs_you_count_and_moves_older_waiting_run_to_finished() {
+        let mut state = LedgerState::new();
+        state.set_runs(vec![
+            make_run("r-old", "Old Gate", RunStatus::Waiting, 1_000),
