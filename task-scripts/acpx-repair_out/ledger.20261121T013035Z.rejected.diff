+        } else {
+            0
+        };
+        let dur_col_w = if !dur_str.is_empty() {
+            1 + dur_str.width()
+        } else {
+            0
+        };
+
+        let fixed_w = prefix_w + rail_col_w + agents_col_w + age_col_w + dur_col_w;
+        let flex_budget = w.saturating_sub(fixed_w);
+        if flex_budget <= 17 {
+            return (prefix_w, 0);
