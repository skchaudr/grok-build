st for quick answers"},{"value":"claude-haiku-4-5-20251001","name":"Haiku 4.5","description":"Fastest for quick answers"},{"value":"claude-sonnet-5","name":"Sonnet 5","description":"Efficient for routine tasks"},{"value":"claude-opus-5","name":"Opus 5","description":"Best for everyday, complex tasks"},{"value":"claude-fable-5","name":"Fable 5","description":"Most capable for your hardest and longest-running tasks"},{"value":"claude-opus-4-8","name":"Opus 4.8","description":"Best for everyday, complex tasks"},{"value":"claude-opus-4-7","name":"Opus 4.7","description":"Best for everyday, complex tasks"},{"value":"claude-opus-4-6","name":"Opus 4.6","description":"Best for everyday, complex tasks"},{"value":"claude-sonnet-4-6","name":"Sonnet 4.6","description":"Efficient for routine tasks"}]},{"id":"effort","name":"Effort","description":"Available effort levels for this model","category":"thought_level","type":"select","currentValue":"low","options":[{"value":"default","name":"Default"},{"value":"low","name":"Low"},{"value":"medium","name":"Medium"},{"value":"high","name":"High"},{"value":"xhigh","name":"Xhigh"},{"value":"max","name":"Max"}]},{"id":"agent","name":"Agent","description":"Main-thread agent persona","type":"select","currentValue":"default","options":[{"value":"default","name":"Default","description":"Standard Claude Code agent"},{"value":"cli-fluency-mentor","name":"cli-fluency-mentor","description":"Use this agent when you want to learn direct CLI tool usage patterns and workflows, transition away from chatbot-dependent development, build command composition skills, or understand how to integrate IDE editors, terminal environments, and external shell commands with AI CLI tools like claude, gemini, aider, and openclaw. This agent helps you develop practical proficiency in piping data between tools, using terminal foreground/background operations, and architecting custom agents for specific tasks."},{"value":"grok-4.5","name":"grok-4.5","description":"Heavier reasoning subagent via Grok 4.5 sub (Hermes). Use for multi-file refactors, architecture tracing, debugging root cause, and tasks needing broader context."},{"value":"grok-composer","name":"grok-composer","description":"Fast bounded implementation worker via Grok 4.5 sub (Hermes). Use for small diffs, file edits, grep-and-fix, test runs, and independent tasks with clear definition of done. (Name kept; Composer 2.5 retired — same model as grok-4.5.)"}]}]}}
